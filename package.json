{
  "name": "aura-verifier",
  "version": "1.2.0",
  "description": "Independent CLI and browser verifier for AURA Evidence Packages.",
  "type": "module",
  "bin": {
    "aura": "./bin/aura.js"
  },
  "scripts": {
    "test": "node tests/run-tests.js",
    "test:timestamp": "node tests/test-timestamp-rfc3161.js && node tests/test-timestamp-public.js",
    "demo:timestamp": "node scripts/verify-timestamp-example.js",
    "demo:offline": "node scripts/offline-demo.js",
    "generate:test-vector": "node scripts/generate-test-vector.js",
    "serve:web": "python3 -m http.server 5177",
    "test:browser": "node tests/test-browser-ui.js"
  },
  "keywords": [
    "aura",
    "evidence",
    "ed25519",
    "sha3",
    "rfc8785",
    "jcs"
  ],
  "author": "AURA contributors",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.62.1"
  }
}
